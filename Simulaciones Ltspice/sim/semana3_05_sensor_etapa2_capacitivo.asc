Version 4
SHEET 1 1700 1050
TEXT 48 48 Left 4 ;SEMANA 3.5 - ETAPA 2: MODELO DEL SENSOR
TEXT 48 104 Left 2 ;Agregar el sensor entre COLECTOR y GND.
TEXT 48 152 Left 3 ;COLECTOR -- Cs -- RESR -- GND
TEXT 48 192 Left 3 ;     |                   |
TEXT 48 232 Left 3 ;     +------ RLEAK ------+
TEXT 48 288 Left 2 ;HUM=0 seco; HUM=3 mojado. CS y RLEAK son valores iniciales ajustables.
TEXT 48 328 Left 2 ;Graficar V(colector). Un Cs mayor reduce el pico durante cada periodo de 2 us.
TEXT 48 376 Left 2 ;View > SPICE Error Log: VC_PK, VC_MIN y VC_AVG para los cuatro pasos.
TEXT 760 48 Left 2 !.param VCCVAL=5 VGPIO=3.3 RBVAL=2.2k RCVAL=10k HUM=0
TEXT 760 80 Left 2 !.param CS=table(HUM,0,15p,1,68p,2,120p,3,180p)
TEXT 760 112 Left 2 !.param RLEAK=table(HUM,0,100Meg,1,20Meg,2,5Meg,3,1Meg)
TEXT 760 144 Left 2 !.param RESR=200
TEXT 760 192 Left 2 !VCC vcc 0 {VCCVAL}
TEXT 760 224 Left 2 !VPWM gpio 0 PULSE(0 {VGPIO} 0 1n 1n 1u 2u)
TEXT 760 256 Left 2 !RB gpio base {RBVAL}
TEXT 760 288 Left 2 !RC vcc colector {RCVAL}
TEXT 760 320 Left 2 !Q1 colector base 0 QNPN
TEXT 760 352 Left 2 !CSENSOR colector sensor_int {CS}
TEXT 760 384 Left 2 !RSENSOR sensor_int 0 {RESR}
TEXT 760 416 Left 2 !RLEAK_SENSOR colector 0 {RLEAK}
TEXT 760 464 Left 2 !.model QNPN NPN(BF=200 VAF=100 IS=1e-14 RB=20 CJE=10p CJC=4p TF=0.5n)
TEXT 760 512 Left 2 !.step param HUM list 0 1 2 3
TEXT 760 544 Left 2 !.tran 0 20u 0 5n
TEXT 760 576 Left 2 !.meas tran VC_PK MAX V(colector) FROM 11u TO 19u
TEXT 760 608 Left 2 !.meas tran VC_MIN MIN V(colector) FROM 11u TO 19u
TEXT 760 640 Left 2 !.meas tran VC_AVG AVG V(colector) FROM 11u TO 19u
