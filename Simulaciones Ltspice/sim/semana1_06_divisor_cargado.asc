Version 4
SHEET 1 1040 720
SYMBOL voltage 48 112 R0
SYMATTR InstName V1
SYMATTR Value 5
SYMBOL res 224 96 R0
SYMATTR InstName Rtop_u
SYMATTR Value R=10k*(1-V(alpha))
SYMBOL res 224 224 R0
SYMATTR InstName Rbot_u
SYMATTR Value R=10k*V(alpha)
SYMBOL res 480 96 R0
SYMATTR InstName Rtop_l
SYMATTR Value R=10k*(1-V(alpha))
SYMBOL res 480 224 R0
SYMATTR InstName Rbot_l
SYMATTR Value R=10k*V(alpha)
SYMBOL res 672 224 R0
SYMATTR InstName Rload
SYMATTR Value 10k
SYMBOL voltage 832 224 R0
SYMATTR InstName Valpha
SYMATTR Value 0.1
FLAG 48 128 vin
FLAG 48 208 0
FLAG 240 112 vin
FLAG 240 192 vout_u
FLAG 240 240 vout_u
FLAG 240 320 0
FLAG 496 112 vin
FLAG 496 192 vout_l
FLAG 496 240 vout_l
FLAG 496 320 0
