Version 4
SHEET 1 1750 1050
TEXT 48 48 Left 4 ;SEMANA 3.7 - ETAPA 4: ADC PROTEGIDO CON 680k
TEXT 48 112 Left 3 ;ADC_RAW -- R5=680k --+-- GP26 / ADC0
TEXT 48 160 Left 3 ;                       |--- R1=1Meg --- GND
TEXT 48 200 Left 3 ;                       +--- C1=1uF ---- GND
TEXT 48 264 Left 2 ;R1 y C1 siguen en paralelo; R5 se agrega en serie antes del nodo GP26.
TEXT 48 304 Left 2 ;Fuente de prueba: 4.493 V seco y 1.600 V mojado.
TEXT 48 344 Left 2 ;Graficar V(adc_raw) y V(adc_gp26).
TEXT 48 392 Left 2 ;Run ejecuta .tran. Ver resultados numericos en SPICE Error Log.
TEXT 760 48 Left 2 !.param RPROT=680k RLOAD=1Meg CFILT=1u
TEXT 760 80 Left 2 !VRAW adc_raw 0 DC 4.493 PWL(0 0 1m 4.493 2.2 4.493 2.201 1.6 4.4 1.6)
TEXT 760 112 Left 2 !R5 adc_raw adc_gp26 {RPROT}
TEXT 760 144 Left 2 !R1 adc_gp26 0 {RLOAD}
TEXT 760 176 Left 2 !C1 adc_gp26 0 {CFILT}
TEXT 760 224 Left 2 !.tran 0 4.4 0 1m
TEXT 760 272 Left 2 !.meas tran VADC_DRY AVG V(adc_gp26) FROM 2.0 TO 2.2
TEXT 760 304 Left 2 !.meas tran VADC_WET AVG V(adc_gp26) FROM 4.2 TO 4.4
TEXT 760 336 Left 2 !.meas tran T_90_WET WHEN V(adc_gp26)=1.124 FALL=1
TEXT 760 400 Left 2 ;Alternativa OP: comentar .tran/.meas tran y agregar .op
TEXT 760 432 Left 2 ;.meas op VADC_OP FIND V(adc_gp26)
TEXT 760 464 Left 2 ;.meas op I_DIV_OP PARAM 4.493/(RPROT+RLOAD)
TEXT 760 512 Left 2 ;Alternativa DC: comentar .tran/.meas tran y agregar .dc VRAW 0 5 0.05
TEXT 760 544 Left 2 ;.meas dc VADC_AT_4V5 FIND V(adc_gp26) AT=4.5
TEXT 760 576 Left 2 ;.meas dc VADC_WORST_5V FIND V(adc_gp26) AT=5
TEXT 48 480 Left 2 ;Opcional: en el archivo .cir se incluye la linea comentada para comparar 470k y 680k.
