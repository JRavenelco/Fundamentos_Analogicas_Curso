Version 4
SHEET 1 1500 1000
TEXT 48 48 Left 4 ;SEMANA 3.4 - ETAPA 1: PWM Y CONMUTADOR NPN
TEXT 48 104 Left 2 ;Objetivo: comprobar el transistor antes de conectar el sensor.
TEXT 48 152 Left 3 ;+5 V -- RC=10k -- COLECTOR
TEXT 48 192 Left 3 ;                       C
TEXT 48 232 Left 3 ;GP16 -- RB=2.2k -- B  Q1 NPN
TEXT 48 272 Left 3 ;                       E
TEXT 48 312 Left 3 ;                       |
TEXT 48 352 Left 3 ;                      GND
TEXT 48 416 Left 2 ;Graficar V(gpio), V(base) y V(colector).
TEXT 48 448 Left 2 ;Esperado: colector invertido; aprox. 0.2 V ON y 5 V OFF.
TEXT 48 496 Left 2 ;View > SPICE Error Log: IB_ON_AVG, IC_ON_AVG, VC_ON_MIN y VC_OFF_MAX.
TEXT 696 48 Left 2 !.param VCCVAL=5 VGPIO=3.3 RBVAL=2.2k RCVAL=10k
TEXT 696 80 Left 2 !VCC vcc 0 {VCCVAL}
TEXT 696 112 Left 2 !VPWM gpio 0 PULSE(0 {VGPIO} 0 1n 1n 1u 2u)
TEXT 696 144 Left 2 !RB gpio base {RBVAL}
TEXT 696 176 Left 2 !RC vcc colector {RCVAL}
TEXT 696 208 Left 2 !Q1 colector base 0 QNPN
TEXT 696 256 Left 2 !.model QNPN NPN(BF=200 VAF=100 IS=1e-14 RB=20 CJE=10p CJC=4p TF=0.5n)
TEXT 696 304 Left 2 !.tran 0 10u 0 5n
TEXT 696 336 Left 2 !.meas tran IB_ON_AVG AVG I(RB) FROM 0.20u TO 0.80u
TEXT 696 368 Left 2 !.meas tran VC_ON_MIN MIN V(colector) FROM 0.20u TO 0.80u
TEXT 696 400 Left 2 !.meas tran VC_OFF_MAX MAX V(colector) FROM 1.20u TO 1.80u
TEXT 696 432 Left 2 !.meas tran IC_ON_AVG AVG I(RC) FROM 0.20u TO 0.80u
